{
  "info": {
    "_postman_id": "d178c322-c5f8-441d-a942-d5ce6f6a93ac",
    "name": "BaoziStore",
    "description": "Requisições da API Baozi Store. Execute os POSTs de cliente e produto antes do POST de pedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "produtoId",
      "value": "1"
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Criar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clienteId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Reminson 5287384\",\n  \"clienteDesde\": \"2026-11-24\"\n}"
            },
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Consultar cliente por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Atualizar cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Reminson 5287384\",\n  \"clienteDesde\": \"2026-11-24\"\n}"
            },
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Criar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('produtoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pãozinho chinês Baozi\",\n  \"preco\": 5.00,\n  \"estoque\": true\n}"
            },
            "url": "{{baseUrl}}/produtos"
          }
        },
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos"
          }
        },
        {
          "name": "Consultar produto por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos/{{produtoId}}"
          }
        },
        {
          "name": "Atualizar produto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pãozinho chinês Baozi\",\n  \"preco\": 5.00,\n  \"estoque\": true\n}"
            },
            "url": "{{baseUrl}}/produtos/{{produtoId}}"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido (5 unidades)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('pedidoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": { \"id\": {{clienteId}} },\n  \"produto\": { \"id\": {{produtoId}} },\n  \"quantidade\": 5\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "Consultar pedido por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}"
          }
        },
        {
          "name": "Apagar pedido",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}"
          }
        }
      ]
    },
    {
      "name": "Limpeza (execute depois de apagar o pedido)",
      "item": [
        {
          "name": "Apagar cliente",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Apagar produto",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/produtos/{{produtoId}}"
          }
        }
      ]
    }
  ]
}
